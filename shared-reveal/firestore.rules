rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      // Own doc read OR pair member reads partner doc for /home partner display (D-05).
      // resource.data.pairId is the target user's pairId; requester must be in that pair.
      // get() here is a billable Firestore read — acceptable at Phase 2 scale (2 users).
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || (
          resource.data.pairId != null
          && request.auth.uid in
             get(/databases/$(database)/documents/pairs/$(resource.data.pairId)).data.members
        )
      );

      // A user can create their own document (initial sign-in via Cloud Function,
      // but allow client create as well for resilience — pairId starts null).
      allow create: if request.auth != null && request.auth.uid == uid;

      // A user can update their own document BUT cannot modify pairId from the client.
      // pairId is only written by Cloud Functions (pair-join flow in Phase 2).
      allow update: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pairId']);

      // Deletion is not permitted from the client.
      allow delete: if false;
    }

    match /pairs/{pairId} {
      // Members can read their pair document (invite code display, member count, etc.)
      allow read: if request.auth != null
        && request.auth.uid in resource.data.members;

      // All writes go through Cloud Functions only — never from the client.
      allow write: if false;
    }

    // Phase 3: Entry metadata — readable by both pair members; no client writes (SEC-02)
    match /pairs/{pairId}/entries/{entryDate} {
      allow read: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/pairs/$(pairId)).data.members;
      allow write: if false;

      // Phase 3: Submission content — owner reads always; partner reads only after reveal (SEC-01, SUBM-05)
      match /submissions/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow read: if request.auth != null
          && request.auth.uid != uid
          && request.auth.uid in get(/databases/$(database)/documents/pairs/$(pairId)).data.members
          && get(/databases/$(database)/documents/pairs/$(pairId)/entries/$(entryDate)).data != null
          && get(/databases/$(database)/documents/pairs/$(pairId)/entries/$(entryDate)).data.status == 'revealed';
        allow write: if false;
      }
    }

    // All other paths are denied until later phases add explicit rules.
    // This deny-all catch prevents accidental over-permissioning.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
