rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Deny all by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Pair photo uploads — user writes only to their own UID path.
    // pairId membership is enforced server-side by the submitEntry Cloud Function;
    // Storage rules just confirm the uploading user matches the path uid.
    // Download URLs are token-scoped so the read rule only applies to
    // non-token direct API reads.
    match /pairs/{pairId}/entries/{entryDate}/{uid}/{filename} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null;
    }
  }
}
