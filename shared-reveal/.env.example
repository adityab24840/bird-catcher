# Firebase Web Config
# Copy this file to .env.local and fill in your Firebase project values.

# CRITICAL: VITE_FIREBASE_AUTH_DOMAIN MUST be your custom Firebase Hosting domain
# (e.g., reveal.yourdomain.com or your-project.web.app), NOT the default
# *.firebaseapp.com subdomain. Using *.firebaseapp.com will break signInWithRedirect
# on iOS Safari standalone mode (Safari 16.1+ blocks the cross-origin iframe — SEC-08).
# Add https://<this-domain>/__/auth/handler to Google OAuth authorized redirect URIs.
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-custom-hosting-domain.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Firebase Emulator hosts (for local development)
# Remove or leave empty to connect to production Firebase services.
# These are only read by the app (not the service worker — SW config is injected at build time via Vite define).
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
