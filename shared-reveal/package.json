{
  "name": "shared-reveal",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prod": "VITE_FIREBASE_AUTH_EMULATOR_HOST= VITE_FIRESTORE_EMULATOR_HOST= tsc -b && VITE_FIREBASE_AUTH_EMULATOR_HOST= VITE_FIRESTORE_EMULATOR_HOST= vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "12.18.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "firebase-admin": "14.3.0",
    "jsdom": "^25.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.5.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
