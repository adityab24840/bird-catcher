# Cloud Functions environment variables
# Copy to functions/.env.local and fill in your values.
# Firebase CLI deploys functions/.env to Cloud Run automatically.
# GCLOUD_PROJECT is auto-set by Firebase at runtime — no need to set it manually.

# Your Firebase Storage bucket (matches VITE_FIREBASE_STORAGE_BUCKET in .env.local)
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
