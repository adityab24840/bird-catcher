{
  "name": "functions",
  "description": "Cloud Functions for Reveal",
  "scripts": {
    "build": "tsc",
    "postinstall": "node scripts/patch-firebase-functions.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "private": true
}
